<Layouts.auth flash={@flash} current_scope={@current_scope}>
  <div class="mb-7">
    <h1 class="text-3xl font-extrabold leading-tight text-[#161616] sm:text-4xl">
      Register your account
    </h1>
    <p class="mt-3 text-sm leading-6 text-[#161616]/60">
      Already registered?
      <.link
        navigate={~p"/users/log-in"}
        class="font-bold text-[#735700] underline decoration-[#f4bf25] decoration-2 underline-offset-4 transition-colors hover:text-[#161616]"
      >
        Log in
      </.link>
    </p>
  </div>

  <.form
    for={@form}
    id="registration_form"
    phx-submit="save"
    phx-change="validate"
    class="grid gap-x-4 sm:grid-cols-2"
  >
    <div>
      <.input
        field={@form[:first_name]}
        type="text"
        label="First Name"
        autocomplete="given-name"
        placeholder="e.g. Alex"
        spellcheck="false"
        required
        phx-mounted={JS.focus()}
        class="h-12 rounded-2xl w-full border border-[#d7d2c7] bg-white px-4 text-[#161616] outline-none transition placeholder:text-[#161616]/30 focus:border-[#b28708] focus:ring-2 focus:ring-[#f4bf25]/20"
        error_class="border-[#b42318] focus:border-[#b42318] focus:ring-[#b42318]/15"
      />
    </div>
    <div>
      <.input
        field={@form[:last_name]}
        type="text"
        label="Last Name"
        autocomplete="family-name"
        placeholder="e.g. Morgan"
        spellcheck="false"
        required
        class="h-12 rounded-2xl w-full border border-[#d7d2c7] bg-white px-4 text-[#161616] outline-none transition placeholder:text-[#161616]/30 focus:border-[#b28708] focus:ring-2 focus:ring-[#f4bf25]/20"
        error_class="border-[#b42318] focus:border-[#b42318] focus:ring-[#b42318]/15"
      />
    </div>
    <div class="sm:col-span-2">
      <.input
        field={@form[:email]}
        type="email"
        label="Email"
        autocomplete="email"
        placeholder="you@example.com"
        spellcheck="false"
        required
        class="h-12 rounded-2xl w-full border border-[#d7d2c7] bg-white px-4 text-[#161616] outline-none transition placeholder:text-[#161616]/30 focus:border-[#b28708] focus:ring-2 focus:ring-[#f4bf25]/20"
        error_class="border-[#b42318] focus:border-[#b42318] focus:ring-[#b42318]/15"
      />
    </div>
    <div class="sm:col-span-2">
      <.input
        field={@form[:msisdn]}
        type="tel"
        label="Phone Number"
        autocomplete="tel"
        placeholder="e.g. +254 700 000 000"
        spellcheck="false"
        required
        class="h-12 rounded-2xl w-full border border-[#d7d2c7] bg-white px-4 text-[#161616] outline-none transition placeholder:text-[#161616]/30 focus:border-[#b28708] focus:ring-2 focus:ring-[#f4bf25]/20"
        error_class="border-[#b42318] focus:border-[#b42318] focus:ring-[#b42318]/15"
      />
    </div>
    <div class="sm:col-span-2">
      <.input
        field={@form[:password]}
        type="password"
        label="Password"
        autocomplete="new-password"
        placeholder="At least 8 characters"
        spellcheck="false"
        required
        class="h-12 rounded-2xl w-full border border-[#d7d2c7] bg-white px-4 text-[#161616] outline-none transition placeholder:text-[#161616]/30 focus:border-[#b28708] focus:ring-2 focus:ring-[#f4bf25]/20"
        error_class="border-[#b42318] focus:border-[#b42318] focus:ring-[#b42318]/15"
      />
    </div>
    <div class="mt-3 sm:col-span-2">
      <.button
        phx-disable-with="Creating account..."
        class="group rounded-2xl flex h-12 w-full items-center justify-center gap-2 bg-[#161616] px-5 font-bold text-white shadow-[0_8px_24px_rgba(22,22,22,0.16)] transition hover:-translate-y-0.5 hover:bg-[#735700] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#b28708]"
      >
        Create an account
        <.icon
          name="hero-arrow-right-mini"
          class="size-4 transition-transform group-hover:translate-x-1"
        />
      </.button>
    </div>
  </.form>
</Layouts.auth>
