<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section
    id="admin-users-page"
    class="mx-auto w-full max-w-[96rem] px-4 py-6 sm:px-6 lg:px-8 lg:py-10"
  >
    <header class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="mb-2 text-xs font-bold text-[#947000]">
          Administration
        </p>
        <h1 class="text-3xl font-extrabold text-[#161616]">Users</h1>
        <p class="mt-2 text-sm text-[#161616]/55">
          Review account details, permissions, and verification status.
        </p>
      </div>
      <div class="flex h-10 rounded-2xl items-center gap-2 self-start border border-[#d8d3c8] bg-white px-4 text-sm font-semibold text-[#161616]/65 sm:self-auto">
        <.icon name="hero-users" class="size-4 text-[#947000]" />
        {length(@users)} Registered
      </div>
    </header>

    <div class="overflow-hidden rounded-2xl border border-[#d8d3c8] bg-white shadow-[0_12px_40px_rgba(22,22,22,0.06)]">
      <div class="overflow-x-auto">
        <table id="users-table" class="table">
          <thead class="bg-[#161616] text-[0.65rem] text-white/60">
            <tr>
              <th class="w-12 text-center">#</th>
              <th>User</th>
              <th>Email</th>
              <th>Phone No</th>
              <th>Role</th>
              <th>Access</th>
              <th>Verified</th>
              <th>Joined</th>
              <th><span class="sr-only">View user</span></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#ece8de]">
            <tr
              :for={{user, index} <- Enum.with_index(@users)}
              id={"user-row-#{user.id}"}
              phx-click="select_user"
              phx-value-user_id={user.id}
              class="group cursor-pointer transition-colors hover:bg-[#faf7ed]"
            >
              <td class="text-center text-xs font-semibold text-[#161616]/35">{index + 1}</td>
              <td>
                <div class="flex min-w-44 items-center gap-3">
                  <div class="grid rounded-2xl size-10 shrink-0 place-items-center bg-[#f4bf25] text-xs font-extrabold text-[#161616]">
                    {Helpers.user_initials(user)}
                  </div>
                  <div>
                    <p class="font-bold text-[#161616]">{user.first_name} {user.last_name}</p>
                    <p class="text-xs text-[#161616]/45">Account #{user.id}</p>
                  </div>
                </div>
              </td>
              <td class="text-sm text-[#161616]/65">{user.email}</td>
              <td class="whitespace-nowrap text-sm text-[#161616]/65">{user.msisdn}</td>
              <td>
                <span class="inline-flex rounded-2xl bg-[#eee9dc] px-2.5 py-1 text-xs font-bold capitalize text-[#68531a]">
                  {user.role}
                </span>
              </td>
              <td>
                <span
                  :if={user.is_superuser}
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#947000]"
                >
                  <.icon name="hero-shield-check-mini" class="size-4" /> Superuser
                </span>
                <span :if={!user.is_superuser} class="text-xs text-[#161616]/35">Standard</span>
              </td>
              <td>
                <span
                  :if={user.confirmed_at}
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700"
                >
                  <span class="size-1.5 bg-emerald-500 rounded-2xl"></span> Verified
                </span>
                <span
                  :if={!user.confirmed_at}
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-amber-700"
                >
                  <span class="size-1.5 bg-amber-500"></span> Pending
                </span>
              </td>
              <td class="whitespace-nowrap text-xs text-[#161616]/50">
                {Helpers.format_date(user.inserted_at)}
              </td>
              <td>
                <.icon
                  name="hero-chevron-right"
                  class="size-4 text-[#161616]/25 transition-transform group-hover:translate-x-1 group-hover:text-[#947000]"
                />
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <div :if={@users == []} class="grid min-h-64 place-items-center px-6 text-center">
        <div>
          <.icon name="hero-users" class="mx-auto mb-3 size-8 text-[#161616]/25" />
          <p class="font-semibold text-[#161616]">No users found</p>
        </div>
      </div>
    </div>

    <.user_modal
      selected_user={@selected_user}
      show_user_modal={@show_user_modal}
      modal_operation={@modal_operation}
      form={@form}
      current_scope={@current_scope}
    />
  </section>
</Layouts.app>
