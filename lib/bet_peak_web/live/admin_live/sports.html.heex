<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section
    id="admin-sports-page"
    class="mx-auto w-full max-w-[96rem] px-4 py-6 sm:px-6 lg:px-8 lg:py-10"
  >
    <header class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="mb-2 text-xs font-bold text-[#947000]">
          Administration
        </p>
        <h1 class="text-3xl font-extrabold text-[#161616]">Sports</h1>
        <p class="mt-2 text-sm text-[#161616]/55">
          View all sports, update, and delete them.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3 sm:ml-auto sm:justify-end">
        <div class="flex h-10 items-center gap-2 rounded-2xl border border-[#d8d3c8] bg-white px-4 text-sm font-semibold text-[#161616]/65">
          <.icon name="hero-play" class="size-4 text-[#947000]" /> {length(@sports)} Created
        </div>
        <.button
          class="btn btn-primary h-10 items-center gap-2 rounded-2xl px-4 text-sm font-semibold text-white"
          phx-click="open_sport_modal"
          phx-value-operation="add"
          phx-value-sport_id=""
        >
          <.icon name="hero-plus" class="size-4 text-white" /> Add Sport
        </.button>
      </div>
    </header>
    <div class="overflow-hidden rounded-2xl border border-[#d8d3c8] bg-white shadow-[0_12px_40px_rgba(22,22,22,0.06)]">
      <div class="overflow-x-auto">
        <table id="sports-table" class="table">
          <thead class="bg-[#161616] text-[0.65rem] text-white/60">
            <tr>
              <th class="w-12 text-center">#</th>
              <th>Name</th>
              <th>Description</th>
              <th>Slug</th>
              <th>Active</th>
              <th>Created</th>
              <th><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#ece8de]">
            <tr
              :for={{sport, index} <- Enum.with_index(@sports)}
              id={"sport-row-#{sport.id}"}
              class="group cursor-pointer transition-colors hover:bg-[#faf7ed]"
            >
              <td class="text-center text-xs font-semibold text-[#161616]/35">{index + 1}</td>
              <td class="whitespace-nowrap">
                <p class="font-bold text-[#161616]">{sport.name}</p>
              </td>
              <td class="text-sm text-[#161616]/65">{sport.description}</td>
              <td class="whitespace-nowrap text-sm text-[#161616]/65">{sport.slug}</td>
              <td class="whitespace-nowrap text-sm text-[#161616]/65">{sport.active}</td>
              <td class="whitespace-nowrap text-xs text-[#161616]/50">
                {Helpers.format_date(sport.inserted_at)}
              </td>
              <td>
                <.button
                  class="btn btn-circle btn-secondary transition-transform group-hover:translate-y-1 mr-2"
                  phx-click="open_sport_modal"
                  phx-value-operation="edit"
                  phx-value-sport_id={sport.id}
                >
                  <.icon
                    name="hero-pencil"
                    class="size-4 text-primary"
                  />
                </.button>
                <.button
                  class="btn btn-circle btn-error transition-transform group-hover:translate-y-1"
                  phx-click="open_sport_modal"
                  phx-value-operation="delete"
                  phx-value-sport_id={sport.id}
                >
                  <.icon
                    name="hero-trash"
                    class="size-4 text-white"
                  />
                </.button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <div :if={@sports == []} class="grid min-h-64 place-items-center px-6 text-center">
        <div>
          <.icon name="hero-play" class="mx-auto mb-3 size-8 text-[#161616]/25" />
          <p class="font-semibold text-[#161616]">No sports found</p>
        </div>
      </div>

      <.sport_modal
        show_sport_modal={@show_sport_modal}
        modal_operation={@modal_operation}
        selected_sport={@selected_sport}
        form={@form}
      />
    </div>
  </section>
</Layouts.app>
